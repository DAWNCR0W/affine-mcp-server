{
  "name": "affine-mcp-server",
  "version": "3.5.0",
  "private": false,
  "type": "module",
  "description": "Model Context Protocol server for AFFiNE - enables AI assistants to interact with AFFiNE workspaces, documents, and collaboration features.",
  "author": "dawncr0w",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DAWNCR0W/affine-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/DAWNCR0W/affine-mcp-server/issues"
  },
  "homepage": "https://github.com/DAWNCR0W/affine-mcp-server#readme",
  "keywords": [
    "mcp",
    "affine",
    "model-context-protocol",
    "ai",
    "claude",
    "knowledge-base"
  ],
  "main": "dist/index.js",
  "bin": {
    "affine-mcp": "bin/affine-mcp"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{ recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "pretest": "npm run build",
    "test": "npm run test:metadata && npm run test:fast",
    "test:metadata": "npm run test:tool-manifest && npm run test:output-schemas && npm run test:surface-element-gating && npm run test:suite-manifest && npm run test:docs",
    "test:fast": "node scripts/run-test-suite.mjs fast",
    "test:suite-manifest": "node scripts/verify-test-suites.mjs",
    "test:live-safety": "node tests/test-live-test-safety.mjs",
    "test:cli-version": "node tests/test-cli-version.mjs",
    "test:cli-commands": "node tests/test-cli-commands.mjs",
    "test:config-consistency": "node tests/test-config-cli-consistency.mjs",
    "test:cli-live": "node tests/test-cli-live.mjs",
    "test:notification-contract": "node tests/test-notification-contract.mjs",
    "test:tool-manifest": "node scripts/verify-tool-manifest.mjs",
    "test:output-schemas": "node --import tsx tests/test-output-schemas.mjs",
    "test:markdown-linked-page": "node tests/test-markdown-linked-page.mjs",
    "test:release-verification": "node tests/test-release-verification.mjs",
    "test:package-smoke": "node tests/test-package-smoke.mjs",
    "test:docs": "node scripts/verify-docs.mjs && node tests/test-docs-drift.mjs",
    "test:mcp-result-contract": "node tests/test-mcp-result-contract.mjs",
    "test:input-contracts": "node tests/test-input-contracts.mjs",
    "test:tool-filtering": "node tests/test-tool-filtering.mjs",
    "test:mutation-ack": "node tests/test-destructive-mutation-ack.mjs",
    "test:pr-route-policy": "node tests/test-pr-route-policy.mjs",
    "test:blob-upload-contract": "node tests/test-blob-upload-contract.mjs",
    "test:secure-random": "node tests/test-secure-random.mjs",
    "test:oauth-service-policy": "node tests/test-oauth-service-policy.mjs",
    "test:comprehensive": "bash tests/run-comprehensive.sh",
    "test:comprehensive:raw": "node test-comprehensive.mjs",
    "test:e2e": "bash tests/run-e2e.sh",
    "test:block-editing": "node tests/test-block-editing.mjs",
    "test:db-create": "node tests/test-database-creation.mjs",
    "test:db-cells": "node tests/test-database-cells.mjs",
    "test:db-linked-doc": "node tests/test-database-linked-doc.mjs",
    "test:db-ui-rows": "node tests/test-database-ui-rows.mjs",
    "test:db-schema": "node tests/test-database-schema.mjs",
    "test:data-view": "node tests/test-data-view.mjs",
    "test:doc-discovery": "node tests/test-doc-discovery.mjs",
    "test:doc-properties": "node tests/test-doc-properties.mjs",
    "test:icons": "node tests/test-icons.mjs",
    "test:read-doc-linked-refs": "node tests/test-read-doc-linked-refs.mjs",
    "test:find-doc-by-title": "node tests/test-find-doc-by-title.mjs",
    "test:create-placement": "node tests/test-create-placement.mjs",
    "test:surface-elements": "node tests/test-surface-elements.mjs",
    "test:surface-element-gating": "node scripts/verify-surface-element-gating.mjs",
    "test:edgeless-seed": "node tests/test-edgeless-canvas-setup.mjs",
    "test:edgeless-ui": "npx playwright test tests/playwright/verify-edgeless-canvas.pw.ts --config tests/playwright/playwright.config.ts",
    "test:capabilities-fidelity": "node tests/test-capabilities-fidelity.mjs",
    "test:native-template": "node tests/test-native-template-instantiation.mjs",
    "test:data-view-ui": "npx playwright test tests/playwright/verify-data-view.pw.ts --config tests/playwright/playwright.config.ts",
    "test:http-email-password": "node tests/test-http-email-password.mjs",
    "test:auth-session": "tsx tests/test-auth-session.mjs",
    "test:http-bearer": "node tests/test-http-bearer.mjs",
    "test:http-security": "tsx tests/test-http-security.mjs",
    "test:http-runtime": "tsx tests/test-http-runtime-safety.mjs",
    "test:oauth-http": "node tests/test-oauth-http.mjs",
    "test:organize": "node tests/test-organize-tools.mjs",
    "test:create-doc-folder-placement": "node tests/test-create-doc-folder-placement.mjs",
    "test:supporting-tools": "node tests/test-supporting-tools.mjs",
    "test:tag-visibility": "node tests/test-tag-visibility.mjs",
    "test:tag-deletion": "node tests/test-tag-deletion.mjs",
    "test:url-safety": "node tests/test-url-safety.mjs",
    "test:workspace-discovery": "node tests/test-workspace-discovery.mjs",
    "test:markdown-roundtrip": "node tests/test-markdown-roundtrip.mjs",
    "test:document-mutation-safety": "node tests/test-document-mutation-safety.mjs",
    "test:markdown-output-safety": "node tests/test-markdown-output-safety.mjs",
    "test:markdown-export-safety": "npm run test:markdown-roundtrip && npm run test:markdown-output-safety",
    "test:markdown-rich-text-import": "node tests/test-markdown-rich-text-import.mjs",
    "test:playwright": "npx playwright test --config tests/playwright/playwright.config.ts",
    "pack:check": "npm pack --dry-run",
    "release:verify": "node scripts/verify-release.mjs",
    "ci": "npm test && npm run pack:check",
    "prepublishOnly": "npm run ci"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "RELEASE_NOTES.md",
    "SECURITY.md",
    "glama.json",
    "tool-manifest.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "form-data": "^4.0.4",
    "jose": "^6.2.1",
    "fractional-indexing": "^4.0.0",
    "markdown-it": "^14.1.0",
    "node-fetch": "^3.3.2",
    "socket.io-client": "^4.8.1",
    "undici": "^7.29.0",
    "yjs": "^13.6.27",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.18.1",
    "tsx": "^4.16.2",
    "typescript": "^7.0.2"
  }
}
